// RIPPLR Orchestrator — Distribution-as-a-Service data model
// Models the flow: Brand -> SKU -> MFC inventory -> Channel (Q-comm / MT / GT / E-com) shelf stock
// with a Green-Channel replenishment engine and SLA tracking.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A brand we distribute for. D2C, national FMCG, regional, or private label.
model Brand {
  id          String   @id @default(cuid())
  name        String   @unique
  type        String // D2C | NATIONAL | REGIONAL | PRIVATE_LABEL
  category    String // e.g. "Dry Fruits", "Personal Care", "Beverages"
  status      String   @default("ACTIVE") // ONBOARDING | ACTIVE | PAUSED
  contactName String?
  contactEmail String?
  onboardedAt DateTime @default(now())

  skus      Sku[]
  shipments Shipment[]
  invoices  Invoice[]

  @@index([type])
}

// A stock keeping unit belonging to a brand.
model Sku {
  id           String  @id @default(cuid())
  code         String  @unique
  name         String
  brandId      String
  category     String
  mrp          Float
  cbmPerUnit   Float   @default(0.001) // cubic metres per unit (for cage / storage economics)
  tempZone     String  @default("AMBIENT") // AMBIENT | CHILLED | FROZEN
  greenChannel Boolean @default(false) // eligible for Green-Channel direct q-commerce feed

  brand       Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  inventory   Inventory[]
  channelStock ChannelStock[]
  replenishments ReplenishmentOrder[]
  salesHistory SalesHistory[]
  returns      Return[]

  @@index([brandId])
}

// A Ripplr Multi/Micro Fulfillment Center.
model Mfc {
  id         String  @id @default(cuid())
  name       String  @unique
  city       String
  region     String // SOUTH | WEST | NORTH | EAST
  zones      String  @default("AMBIENT") // comma list: AMBIENT,CHILLED,FROZEN
  capacityCbm Float  @default(5000)

  inventory      Inventory[]
  channelStock   ChannelStock[]
  replenishments ReplenishmentOrder[]
  returns        Return[]
  deliveries     Delivery[]
}

// A downstream demand channel: a q-commerce platform, modern trade chain,
// general trade cluster, or e-commerce marketplace.
model Channel {
  id       String @id @default(cuid())
  name     String @unique // "Blinkit", "Zepto", "DMart", "Amazon", "GT - Bangalore"
  type     String // Q_COMMERCE | MODERN_TRADE | GENERAL_TRADE | ECOM | EXPORT
  city     String?
  greenChannel Boolean @default(false) // supports Ripplr Green-Channel direct feed

  channelStock   ChannelStock[]
  replenishments ReplenishmentOrder[]
  salesHistory   SalesHistory[]
  returns        Return[]
  invoices       Invoice[]
  deliveries     Delivery[]

  @@index([type])
}

// Stock physically held at a Ripplr MFC (source of truth for what we can dispatch).
model Inventory {
  id          String   @id @default(cuid())
  skuId       String
  mfcId       String
  onHand      Int      @default(0)
  allocated   Int      @default(0) // reserved against open replenishments
  inTransit   Int      @default(0) // inbound from brand
  safetyStock Int      @default(0)
  updatedAt   DateTime @updatedAt

  sku Sku @relation(fields: [skuId], references: [id], onDelete: Cascade)
  mfc Mfc @relation(fields: [mfcId], references: [id], onDelete: Cascade)

  @@unique([skuId, mfcId])
  @@index([mfcId])
}

// Stock + demand signal at a downstream channel (e.g. units on a Blinkit dark store shelf).
model ChannelStock {
  id            String   @id @default(cuid())
  skuId         String
  channelId     String
  mfcId         String? // serving MFC
  onShelf       Int      @default(0)
  dailyVelocity Float    @default(0) // last-known avg units sold/day
  forecastVelocity Float @default(0) // engine-computed forecast (updated on each run)
  leadTimeHours Int      @default(48) // MFC -> channel replenishment lead time
  targetCoverDays Int    @default(7) // desired days-of-cover at channel
  fillRate      Float    @default(1) // 0..1 rolling fill rate
  lastSyncAt    DateTime @default(now())

  sku     Sku     @relation(fields: [skuId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  mfc     Mfc?    @relation(fields: [mfcId], references: [id])

  @@unique([skuId, channelId])
  @@index([channelId])
}

// A replenishment / purchase order generated by the orchestration engine.
model ReplenishmentOrder {
  id          String   @id @default(cuid())
  skuId       String
  mfcId       String
  channelId   String
  qty         Int
  reason      String // why the engine raised it
  priority    String   @default("NORMAL") // CRITICAL | HIGH | NORMAL
  status      String   @default("SUGGESTED") // SUGGESTED | APPROVED | DISPATCHED | DELIVERED | CANCELLED
  tatHours    Int      @default(48)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sku     Sku     @relation(fields: [skuId], references: [id], onDelete: Cascade)
  mfc     Mfc     @relation(fields: [mfcId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([skuId])
}

// Daily offtake (units sold) at a channel — the demand signal the forecast
// engine learns from. One row per SKU x channel x day.
model SalesHistory {
  id        String   @id @default(cuid())
  skuId     String
  channelId String
  date      DateTime
  units     Int

  sku     Sku     @relation(fields: [skuId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([skuId, channelId, date])
  @@index([skuId, channelId])
}

// A reverse-logistics return flowing back from a channel into an MFC's returns
// zone. Lifecycle: INITIATED -> IN_QC -> DISPOSITIONED -> CLOSED.
// A RESELL disposition restocks the MFC; all dispositions book recovered value.
model Return {
  id             String    @id @default(cuid())
  skuId          String
  channelId      String
  mfcId          String // processing MFC (reverse-logistics zone)
  qty            Int
  reason         String // DAMAGED | NEAR_EXPIRY | WRONG_ITEM | QUALITY_ISSUE | OVERSTOCK | CUSTOMER_RETURN
  status         String    @default("INITIATED") // INITIATED | IN_QC | DISPOSITIONED | CLOSED
  disposition    String? // RESELL | REFURBISH | RECYCLE | DISPOSE
  inspectionPoints Int     @default(23) // 23-point QC protocol from the OutNIF deck
  recoveredValue Float     @default(0) // INR recovered at disposition
  restocked      Boolean   @default(false)
  notes          String?
  createdAt      DateTime  @default(now())
  processedAt    DateTime? // when dispositioned
  updatedAt      DateTime  @updatedAt

  sku     Sku     @relation(fields: [skuId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  mfc     Mfc     @relation(fields: [mfcId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([skuId])
  @@index([reason])
}

// A cross-border trade lane in the OutNIF corridor (e.g. India -> UAE).
// Holds the lane economics from the corridor deck: traditional vs OutNIF
// cost and transit, for the savings analysis.
model TradeLane {
  id                  String @id @default(cuid())
  name                String @unique // "India → UAE"
  origin              String
  destination         String
  traditionalCostUsd  Int
  outnifCostUsd       Int
  traditionalTransitDays Int
  outnifTransitDays   Int
  sequence            Int    @default(0) // order along the corridor

  shipments Shipment[]
}

// A container moving along a trade lane, tracked through the control tower.
model Shipment {
  id            String   @id @default(cuid())
  reference     String   @unique // "OUTNIF-00001"
  laneId        String
  brandId       String?
  containerNo   String
  hsCode        String // customs classification
  category      String // FMCG | PHARMA | CONSUMER_DURABLES | COLD_CHAIN
  tempControlled Boolean @default(false)
  valueUsd      Int
  status        String   @default("BOOKED") // BOOKED | CONSOLIDATING | IN_TRANSIT | CUSTOMS | AT_HUB | OUT_FOR_DELIVERY | DELIVERED | EXCEPTION
  departedAt    DateTime?
  etaAt         DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lane       TradeLane          @relation(fields: [laneId], references: [id], onDelete: Cascade)
  brand      Brand?             @relation(fields: [brandId], references: [id])
  milestones ShipmentMilestone[]

  @@index([status])
  @@index([laneId])
}

// A control-tower tracking event for a shipment (Shipsy-style timeline).
model ShipmentMilestone {
  id         String   @id @default(cuid())
  shipmentId String
  location   String
  status     String
  note       String?
  at         DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
}

// An accounts-receivable invoice raised to a channel (the Collection App).
// Status: OPEN | PARTIAL | PAID | OVERDUE (overdue derived from dueDate).
model Invoice {
  id         String   @id @default(cuid())
  number     String   @unique // "INV-00001"
  channelId  String
  brandId    String?
  amount     Float
  paidAmount Float    @default(0)
  status     String   @default("OPEN")
  issuedAt   DateTime @default(now())
  dueDate    DateTime
  updatedAt  DateTime @updatedAt

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  brand   Brand?  @relation(fields: [brandId], references: [id])

  @@index([status])
  @@index([channelId])
}

// A last-mile delivery trip from an MFC to a channel (the Delivery App).
// Status: PENDING | DISPATCHED | OUT_FOR_DELIVERY | DELIVERED | FAILED.
model Delivery {
  id          String    @id @default(cuid())
  reference   String    @unique // "TRIP-00001"
  mfcId       String
  channelId   String
  status      String    @default("PENDING")
  driverName  String
  vehicleNo   String
  stops       Int       @default(1)
  units       Int       @default(0)
  slaHours    Int       @default(24)
  etaAt       DateTime?
  dispatchedAt DateTime?
  deliveredAt DateTime?
  onTime      Boolean?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  mfc     Mfc     @relation(fields: [mfcId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([status])
}
