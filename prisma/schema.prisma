// RIPPLR Orchestrator — Distribution-as-a-Service data model
// Models the flow: Brand -> SKU -> MFC inventory -> Channel (Q-comm / MT / GT / E-com) shelf stock
// with a Green-Channel replenishment engine and SLA tracking.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A brand we distribute for. D2C, national FMCG, regional, or private label.
model Brand {
  id          String   @id @default(cuid())
  name        String   @unique
  type        String // D2C | NATIONAL | REGIONAL | PRIVATE_LABEL
  category    String // e.g. "Dry Fruits", "Personal Care", "Beverages"
  status      String   @default("ACTIVE") // ONBOARDING | ACTIVE | PAUSED
  contactName String?
  contactEmail String?
  onboardedAt DateTime @default(now())

  skus Sku[]

  @@index([type])
}

// A stock keeping unit belonging to a brand.
model Sku {
  id           String  @id @default(cuid())
  code         String  @unique
  name         String
  brandId      String
  category     String
  mrp          Float
  cbmPerUnit   Float   @default(0.001) // cubic metres per unit (for cage / storage economics)
  tempZone     String  @default("AMBIENT") // AMBIENT | CHILLED | FROZEN
  greenChannel Boolean @default(false) // eligible for Green-Channel direct q-commerce feed

  brand       Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  inventory   Inventory[]
  channelStock ChannelStock[]
  replenishments ReplenishmentOrder[]

  @@index([brandId])
}

// A Ripplr Multi/Micro Fulfillment Center.
model Mfc {
  id         String  @id @default(cuid())
  name       String  @unique
  city       String
  region     String // SOUTH | WEST | NORTH | EAST
  zones      String  @default("AMBIENT") // comma list: AMBIENT,CHILLED,FROZEN
  capacityCbm Float  @default(5000)

  inventory      Inventory[]
  channelStock   ChannelStock[]
  replenishments ReplenishmentOrder[]
}

// A downstream demand channel: a q-commerce platform, modern trade chain,
// general trade cluster, or e-commerce marketplace.
model Channel {
  id       String @id @default(cuid())
  name     String @unique // "Blinkit", "Zepto", "DMart", "Amazon", "GT - Bangalore"
  type     String // Q_COMMERCE | MODERN_TRADE | GENERAL_TRADE | ECOM | EXPORT
  city     String?
  greenChannel Boolean @default(false) // supports Ripplr Green-Channel direct feed

  channelStock   ChannelStock[]
  replenishments ReplenishmentOrder[]

  @@index([type])
}

// Stock physically held at a Ripplr MFC (source of truth for what we can dispatch).
model Inventory {
  id          String   @id @default(cuid())
  skuId       String
  mfcId       String
  onHand      Int      @default(0)
  allocated   Int      @default(0) // reserved against open replenishments
  inTransit   Int      @default(0) // inbound from brand
  safetyStock Int      @default(0)
  updatedAt   DateTime @updatedAt

  sku Sku @relation(fields: [skuId], references: [id], onDelete: Cascade)
  mfc Mfc @relation(fields: [mfcId], references: [id], onDelete: Cascade)

  @@unique([skuId, mfcId])
  @@index([mfcId])
}

// Stock + demand signal at a downstream channel (e.g. units on a Blinkit dark store shelf).
model ChannelStock {
  id            String   @id @default(cuid())
  skuId         String
  channelId     String
  mfcId         String? // serving MFC
  onShelf       Int      @default(0)
  dailyVelocity Float    @default(0) // avg units sold/day (ML forecast proxy)
  targetCoverDays Int    @default(7) // desired days-of-cover at channel
  fillRate      Float    @default(1) // 0..1 rolling fill rate
  lastSyncAt    DateTime @default(now())

  sku     Sku     @relation(fields: [skuId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  mfc     Mfc?    @relation(fields: [mfcId], references: [id])

  @@unique([skuId, channelId])
  @@index([channelId])
}

// A replenishment / purchase order generated by the orchestration engine.
model ReplenishmentOrder {
  id          String   @id @default(cuid())
  skuId       String
  mfcId       String
  channelId   String
  qty         Int
  reason      String // why the engine raised it
  priority    String   @default("NORMAL") // CRITICAL | HIGH | NORMAL
  status      String   @default("SUGGESTED") // SUGGESTED | APPROVED | DISPATCHED | DELIVERED | CANCELLED
  tatHours    Int      @default(48)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sku     Sku     @relation(fields: [skuId], references: [id], onDelete: Cascade)
  mfc     Mfc     @relation(fields: [mfcId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([skuId])
}
